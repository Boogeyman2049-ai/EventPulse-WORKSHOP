# ==============================================================================
# EventPulse Backend Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials
# ==============================================================================

PORT=5000
NODE_ENV=development

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Public key for client-scoped operations)
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Service Role Key (Admin secret key - NEVER expose to frontend)
# Used by backend to perform administrative checks and verify tokens
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. CORS Allowed Origins (Comma separated or * for local development)
CORS_ORIGIN=*
